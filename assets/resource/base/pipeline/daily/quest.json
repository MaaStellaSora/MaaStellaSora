{
    "委托_入口": {
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "next": [
            "委托_判断是否在主页",
            "[JumpBack]通用_返回主页"
        ]
    },
    "委托_判断是否在主页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "menu.png"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "委托_前往委托"
        ]
    },
    "委托_再次派遣": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "再次派遣"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "通用_返回主页"
        ]
    },
    "委托_前往委托": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "entrust.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000,
        "timeout": 5000,
        "next": [
            "委托_一键领取"
        ],
        "on_error": [
            "通用_返回主页"
        ],
        "focus": {
            "Node.Action.Succeeded": "前往委托"
        }
    },
    "委托_一键领取": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "quick_claim.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1500,
        "timeout": 5000,
        "next": [
            "[JumpBack]委托_跳过",
            "委托_再次派遣",
            "[JumpBack]通用_关闭升级界面"
        ],
        "focus": {
            "Node.Action.Starting": "正在尝试一键领取"
        }
    },
    "委托_跳过": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "跳过"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "通用_点击空白处继续"
        ]
    }
}
