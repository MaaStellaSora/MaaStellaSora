        "悬赏试炼跳过难度选择": {
            "type": "switch",
            "label": "$interface.task.option.悬赏试炼跳过难度选择.label",
            "description": "$interface.task.option.悬赏试炼跳过难度选择.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "No",
                    "option": [
                        "选择悬赏试炼难度"
                    ]
                },
                {
                    "name": "Yes",
                    "label": "Yes",
                    "pipeline_override": {
                        "战斗_试炼出发": {
                            "next": [
                                "战斗_快速战斗",
                                "[JumpBack]战斗_选择试炼子菜单"
                            ]
                        }
                    }
                }
            ]
        },
        "选择悬赏试炼难度": {
            "type": "input",
            "inputs": [
                {
                    "name": "难度",
                    "label": "$interface.task.option.选择悬赏试炼难度.inputs.难度.label",
                    "pipeline_type": "string",
                    "default": "1",
                    "verify": "^\\d+$",
                    "pattern_msg": "$interface.task.option.选择悬赏试炼难度.inputs.难度.pattern_msg",
                    "description": "$interface.task.option.选择悬赏试炼难度.inputs.难度.description"
                }
            ],
            "pipeline_override": {
                "战斗_选择难度": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "(难度|難度|難易度|Difficulty){难度}(?!\\d)"
                            ]
                        }
                    },
                    "focus": {
                        "Node.Action.Succeeded": "选择难度_{难度}"
                    }
                }
            }
        },
        "悬赏试炼消耗所有干劲": {
            "type": "switch",
            "label": "$interface.task.option.悬赏试炼消耗所有干劲.label",
            "description": "$interface.task.option.悬赏试炼消耗所有干劲.description",
