{
    "option": {
        "新版爬塔_设置爬塔目标": {
            "label": "$interface.task.option.新版爬塔_设置爬塔目标.label",
            "description": "$interface.task.option.新版爬塔_设置爬塔目标.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "No",
                },
                {
                    "name": "Yes",
                    "label": "Yes",
                    "option": [
                        "新版爬塔_爬塔目标"
                    ]
                }
            ]
        },
        "新版爬塔_爬塔目标": {
            "label": "$interface.task.option.新版爬塔_爬塔目标.label",
            "type": "input",
            "inputs": [
                {
                    "name": "潜能数目标",
                    "label": "$interface.task.option.新版爬塔_爬塔目标.inputs.潜能数目标.label",
                    "description": "$interface.task.option.新版爬塔_爬塔目标.inputs.潜能数目标.description",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$interface.task.option.新版爬塔_爬塔目标.inputs.潜能数目标.pattern_msg"
                },
                {
                    "name": "记录等级目标",
                    "label": "$interface.task.option.新版爬塔_爬塔目标.inputs.记录等级目标.label",
                    "description": "$interface.task.option.新版爬塔_爬塔目标.inputs.记录等级目标.description",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$interface.task.option.新版爬塔_爬塔目标.inputs.记录等级目标.pattern_msg"
                }
            ],
            "pipeline_override": {
                "星塔_循环用节点_agent": {
                    "attach": {
                        "min_potential_count": "{潜能数目标}",
                        "min_record_level": "{记录等级目标}"
                    }
                }
            }
        }
    }
}
