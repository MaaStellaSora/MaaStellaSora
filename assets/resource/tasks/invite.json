{
    "task": [
        {
            "name": "邀约",
            "entry": "邀约_入口",
            "description": "自动邀约<br>由于选项过多，可能需要下拉菜单才能看到其他选项",
            "option": [
                "邀约_回忆收集模式",
                "邀约旅人",
                "邀约旅人_1号_送礼",
                "邀约旅人_2号_送礼",
                "邀约旅人_3号_送礼",
                "邀约旅人_4号_送礼",
                "邀约旅人_5号_送礼"
            ]
        }
    ],
    "option": {
