{
    "option": {
        "新版爬塔_商店_强化_自定义选项开关": {
            "label": "$interface.task.option.新版爬塔_商店_强化_自定义选项开关.label",
            "description": "$interface.task.option.新版爬塔_商店_强化_自定义选项开关.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "No",
                },
                {
                    "name": "Yes",
                    "label": "Yes",
                    "option": [
                        "新版爬塔_商店_最大强化金额",
                        "新版爬塔_商店_初始强化金额"
                    ]
                }
            ]
        },
        "新版爬塔_商店_最大强化金额": {
            "type": "input",
            "inputs": [
                {
                    "name": "最大强化金额",
                    "label": "$interface.task.option.新版爬塔_商店_最大强化金额.inputs.最大强化金额.label",
                    "default": "180",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "description": "$interface.task.option.新版爬塔_商店_最大强化金额.inputs.最大强化金额.description"
                }
            ],
            "pipeline_override": {
                "星塔_节点_商店_强化_agent": {
                    "attach": {
                        "max_cost": "{最大强化金额}"
                    }
                }
            }
        },
        "新版爬塔_商店_初始强化金额": {
            "type": "input",
            "inputs": [
                {
                    "name": "初始强化金额",
                    "label": "$interface.task.option.新版爬塔_商店_初始强化金额.inputs.初始强化金额.label",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "description": "$interface.task.option.新版爬塔_商店_初始强化金额.inputs.初始强化金额.description"
                }
            ],
            "pipeline_override": {
                "星塔_节点_商店_强化_agent": {
                    "attach": {
                        "initial_cost": "{初始强化金额}"
                    }
                }
            }
        }
    }
}
