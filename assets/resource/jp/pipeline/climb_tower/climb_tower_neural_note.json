{
    "星塔_音符采集_背包数量": {
        "recognition": {
            "param": {
                "expected": [
                    "未獲得",
                    "(?:[LlI1][Vv][.:]?\\s*(\\d+)|(\\d+)\\s*[個枚])"
                ]
            }
        },
        "attach": {
            "text_rules": {
                "zero": "未獲得",
                "count": "(?:[LlI1][Vv][.:]?\\s*(\\d+)|(\\d+)\\s*[個枚])"
            }
        }
    },
    "星塔_音符采集_协奏等级": {
        "recognition": {
            "param": {
                "expected": [
                    "未発動|未解放",
                    "(?:[Ll][Vv][.:]?|レベル)\\s*(\\d+)",
                    "(?:(?:[Ll][Vv][.:]?|レベル)\\s*)?(?:MAX|最大)"
                ]
            }
        },
        "attach": {
            "text_rules": {
                "inactive": "未発動|未解放",
                "level": "(?:[Ll][Vv][.:]?|レベル)\\s*(\\d+)",
                "maximum": "(?:(?:[Ll][Vv][.:]?|レベル)\\s*)?(?:MAX|最大)"
            }
        }
    },
    "星塔_音符采集_事件文本规则": {
        "attach": {
            "text_rules": {
                "note": "音符",
                "potential": "素質",
                "spend": "消費[^，,。;；]*音符|音符[^，,。;；]*消費",
                "random": "ランダム",
                "amount": "(\\d+)\\s*[個枚][^，,、。;；\\d]{0,12}音符|音符[^，,、。;；\\d]*?(\\d+)\\s*[個枚]"
            }
        }
    }
}
