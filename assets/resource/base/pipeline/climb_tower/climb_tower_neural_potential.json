    "星塔_神经网络_潜能_定位等级上升图标": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ClimbTower_neural/潜能等级上升标记.png",
                "threshold": 0.8
            }
        }
    },
    "星塔_神经网络_潜能_定位等级过渡图标": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ClimbTower_neural/潜能等级过渡标记.png",
                "threshold": 0.8
            }
        }
    },
    "星塔_神经网络_潜能_识别潜能等级": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "\\d+"
                ],
                "replace": [],
                "threshold": 0.6
            }
        },
        "attach": {
            "strict_number_reading": true
        }
    },
    "星塔_神经网络_潜能_识别潜能等级后值": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "\\d+"
                ],
                "replace": [],
                "threshold": 0.6
            }
        },
        "attach": {
            "strict_number_reading": true
        }
    },
    "星塔_神经网络_潜能_识别推荐等级": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "星塔_节点_选择潜能_识别推荐图标_agent",
                "roi_offset": [
                    -69,
                    4,
                    0,
                    -5
                ],
                "expected": [
                    "\\d+"
                ],
                "replace": [],
                "only_rec": true,
                "threshold": 0.6
            }
        },
        "attach": {
            "strict_number_reading": true
        }
    },
    "星塔_神经网络_潜能_识别潜能名称": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    ".+"
                ],
                "threshold": 0.6,
                "order_by": "Vertical",
                "roi_offset": [
                    0,
                    10,
                    0,
                    -10
                ],
                "only_rec": true
            }
        }
    },
    "星塔_神经网络_潜能_点击刷新": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "ClimbTower_agent/爬塔_商店刷新按钮__1199_609_45_41__1149_559_131_141.png"
                ],
                "roi": [
                    1090,
                    550,
                    190,
                    170
                ]
