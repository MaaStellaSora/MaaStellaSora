{
    "task": [
        {
            "name": "活动挑战关卡自动战斗",
            "label": "$interface.task.活动挑战关卡自动战斗.label",
            "entry": "活动挑战_入口",
            "description": "$interface.task.活动挑战关卡自动战斗.description",
            "option": [
                "活动挑战重复次数"
            ]
        }
    ],
    "option": {
        "活动挑战重复次数": {
            "type": "input",
            "label": "$interface.task.option.活动挑战重复次数.label",
            "inputs": [
                {
                    "name": "挑战次数",
                    "label": "$interface.task.option.活动挑战重复次数.inputs.挑战次数.label",
                    "description": "$interface.task.option.活动挑战重复次数.inputs.挑战次数.description",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "活动挑战_执行循环": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "activity_challenge_battle_loop",
                            "custom_action_param": "{挑战次数}"
                        }
                    }
                }
            }
        }
    }
}
