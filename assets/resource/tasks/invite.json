            "type": "input",
            "inputs": [
                {
                    "name": "1号",
                    "pipeline_type": "string",
                    "default": "希娅",
                    "description": "请输入旅人名字，如希娅。如没有邀约对象请输入字母x或留空。"
                },
                {
                    "name": "2号",
                    "pipeline_type": "string",
                    "default": "雾语",
                    "description": "请输入旅人名字，如希娅。如没有邀约对象请输入字母x或留空。"
                },
                {
                    "name": "3号",
