{
    "schema_version": 1,
    "description": "Visible Maa Pipeline OCR consequences to frozen event semantics. Patterns describe localizations, never OCR character substitutions. Quiz answer text remains in ascension_event_<language>.json.",
    "policy": {
        "id": "visible_menu_afterstate_v1",
        "value_samples": 16
    },
    "text": {
        "number_pattern": "\\d+",
        "patterns": {
            "potential": "潜能|潛能|素質|potential",
            "note": "音符|musical note|random note|强攻|強攻|強撃|pummel|幸运|幸運|luck|暴发|暴發|爆发|爆發|爆発|burst|体力|體力|stamina|专注|專注|集中|focus|技巧|器用|skill|绝招|絕招|必殺|ultimate",
            "hp": "生命|hp|体力|生命値",
            "quiz": "正确回答|正確答案|正解すると|correct answer",
            "spend": "消耗|消費|spend",
            "restore": "恢复|恢復|回復|restore|recover",
            "gain": "獲得|获得|obtain|gain",
            "change": "随机(?:发生)?变化|隨機(?:發生)?變化|ランダムで変動|randomly change",
            "has_650": "650",
            "has_200": "200",
            "has_100": "100",
            "has_120": "120",
            "has_150": "150",
            "gain_30": "(?:获得|獲得|obtain|gain)[^\\d]{0,12}30|(?:を|×|x)\\s*30\\s*枚?\\s*獲得"
        },
        "classifiers": {
            "quality": [
                {
                    "pattern": "稀有|虹|rare",
                    "value": "rare"
                },
                {
                    "pattern": "普通|common|normal potential|素質[（(](?:金|青)[）)]",
                    "value": "common"
                }
            ],
            "scope": [
                {
                    "pattern": "援护|援護|支援|support|assist",
                    "value": "support"
                },
                {
                    "pattern": "主控|主角|主役|操作中|main|active trekker",
                    "value": "main"
                }
            ],
            "chance": [
                {
                    "pattern": "33%",
                    "value": 33
                },
                {
                    "pattern": "50%\\s*(?:概率|機率|几率|chance|の確率|获得|獲得|失去|恢复|回復|[)）])|概率[^,]*50%|[（(]50%",
                    "value": 50
                }
            ],
            "change_scope": [
                {
                    "pattern": "生命|hp|体力|生命値",
                    "value": "hp"
                }
            ]
        },
        "classifier_defaults": {
            "quality": "",
            "scope": "",
            "chance": 0,
            "change_scope": ""
        },
        "captures": {
            "coin_cost": [
                {
                    "pattern": "(?:を|×|x)\\s*(\\d+)\\s*枚?\\s*消費"
                },
                {
                    "pattern": "(?:消耗|消費|spend)\\s*(?:辉光币|輝光幣|coins?)?\\s*[x×]?\\s*(\\d+)\\s*(?:枚|金币|金幣|coins?|to\\b|,)"
                },
                {
                    "pattern": "(?:消耗|消費|spend)\\s*[^\\d]{0,8}(\\d+)(?!\\d|\\s*%)",
                    "when": {
                        "note": false,
                        "hp": false
                    }
                }
            ],
            "hp_cost": [
                {
                    "pattern": "(?:消耗|消費|spend)\\s*(?:最大|max\\s*)?(?:hp)?\\s*(\\d+)\\s*%"
                },
                {
                    "pattern": "(?:最大)?hp(?:を)?\\s*(\\d+)\\s*%\\s*(?:消費|消耗)"
                }
            ]
        },
        "note_kinds": [
            {
                "melody": "random",
                "pattern": "随机音符|隨機音符|ランダム(?:な|の)?音符|音符をランダムで|random(?:ly)?\\s*(?:musical\\s*)?notes?",
                "suffix": 8
            },
            {
                "melody": "melody_of_pummel",
                "pattern": "强攻|強攻|強撃|pummel",
                "suffix": 1
            },
            {
                "melody": "melody_of_luck",
                "pattern": "幸运|幸運|luck",
                "suffix": 2
            },
            {
                "melody": "melody_of_burst",
                "pattern": "暴发|暴發|爆发|爆發|爆発|burst",
                "suffix": 3
            },
            {
                "melody": "melody_of_stamina",
                "pattern": "体力|體力|stamina",
                "suffix": 4
            },
            {
                "melody": "melody_of_focus",
                "pattern": "专注|專注|集中|focus",
                "suffix": 5
            },
            {
                "melody": "melody_of_skill",
                "pattern": "技巧|器用|skill",
                "suffix": 6
            },
            {
                "melody": "melody_of_ultimate",
                "pattern": "绝招|絕招|必殺|ultimate",
                "suffix": 7
            }
        ]
    },
    "effect_rules": [
        {
            "when": {
                "change": true
            },
            "effect": {
                "kind": "change",
                "amount": {
                    "field": "potential"
                },
                "scope": {
                    "field": "change_scope"
                }
            }
        },
        {
            "when": {
                "has_650": true,
                "has_200": true
            },
            "effect": {
                "kind": "coin_gamble",
                "amount": 650
            }
        },
        {
            "when": {
                "has_200": true,
                "has_100": true,
                "chance": true
            },
            "effect": {
                "kind": "coin_gamble",
                "amount": 200
