{
    "task": [
        {
            "name": "新版爬塔",
            "entry": "星塔_入口_agent",
            "description": "新版爬塔目前仍在测试，如有问题请通过issue等渠道反馈\n\n自动爬塔仅为完成日常周常使用，如要刷取冲榜纪录请自行手动刷取",
            "option": [
                "新版爬塔_开始位置",
                "新版爬塔_爬塔次数",
                "新版爬塔_属性塔",
                "新版爬塔_潜能选择模式",
                "新版爬塔_潜能最大刷新次数",
                "新版爬塔_商店_自定义选项开关",
                "新版爬塔_商店_强化_自定义选项开关",
                "新版爬塔_事件选项策略文件",
                "新版爬塔_设置爬塔目标",
            ]
        }
    ],
    "option": {
        "新版爬塔_开始位置": {
            "type": "select",
            "label": "开始位置",
            "description": "设置在哪个界面开始任务",
            "default_case": "主页",
            "cases": [
                {
                    "name": "开始位置_主页",
                    "label": "主页",
                    "description": "从主页开始，不需要调整编队时选择"
                },
                {
                    "name": "开始位置_进入星塔后",
                    "label": "进入星塔后",
                    "description": "进入星塔后开始，需要调整编队时或爬塔中断时选择",
                    "pipeline_override": {
                        "星塔_跳过进入星塔流程_agent": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "新版爬塔_爬塔次数": {
            "type": "input",
            "inputs": [
                {
                    "name": "爬塔次数",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入爬塔次数"
                }
            ],
            "pipeline_override": {
                "星塔_循环用节点_agent": {
                    "attach": {
                        "loop_count": "{爬塔次数}"
                    }
                }
            }
        },
        "新版爬塔_属性塔": {
            "type": "select",
            "label": "属性塔",
            "default_case": "属性_光土",
            "cases": [
                {
                    "name": "属性_光土",
                    "label": "光土",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_光土__387_137_124_45__337_87_224_145.png"
                                    ]
                                }
                            },
                            "attach": {
                                "active_melodies": ["melody_of_lux", "melody_of_terra"]
                            }
                        }
                    }
                },
                {
                    "name": "属性_水风",
                    "label": "水风",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_水风__384_271_129_39__334_221_229_139.png"
                                    ]
                                }
                            },
                            "attach": {
                                "active_melodies": ["melody_of_aqua", "melody_of_ventus"]
                            }
                        }
                    }
                },
                {
                    "name": "属性_火暗",
                    "label": "火暗",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_火暗__381_404_129_39__331_354_229_139.png"
                                    ]
                                }
                            },
                            "attach": {
                                "active_melodies": ["melody_of_ignis", "melody_of_umbra"]
                            }
                        }
                    }
                }
            ]
        },
        "新版爬塔_潜能选择模式": {
            "type": "select",
            "label": "潜能选择模式",
            "default_case": "内置选择策略",
            "cases": [
                {
                    "name": "内置选择策略",
                    "description": "会识别潜能等级、推荐等级等数据，使用内置的选择策略选择潜能",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "handler": "preset"
                            }
                        }
                    },
                    "option": [
                        "新版爬塔_策略"
                    ]
                },
                {
                    "name": "直接选择推荐潜能(备用)",
                    "description": "直接选择第一位的推荐潜能，如无推荐潜能将会尝试使用刷新（刷新次数会根据配置调整）。在选择策略模块失效但又不在意爬塔质量时可以使用",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "handler": "default"
                            }
                        }
                    }
                },
                {
                    "name": "自定义json优先级",
                    "description": "半周年后，由于游戏更新预设作业功能，自定义json优先级模块已停止持续性维护<br>如果想要使用，需要具有编写json轻代码的能力，且建议配合AI阅读文档后再使用<br>请不要在预设的json保存自己的内容，版本更新时你的内容将会被覆盖！",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "handler": "json"
                            }
                        }
                    },
                    "option": [
                        "预设作业_手动输入作业名",
                        "新版爬塔_开始任务前清空内存"
                    ]
                }
            ]
        },
        "新版爬塔_策略": {
            "type": "select",
            "label": "策略",
            "default_case": "通用",
            "cases": [
                {
                    "name": "通用",
                    "label": "通用(塔7以下)",
                    "description": "通用策略，优先选择升级跨度大的，或者高等级的推荐潜能。如无推荐潜能将会刷新。<br>该策略使用刷新较少，在塔7以下潜能总数会更多，但是潜能种类数会较少。建议把刷新上限调到2左右",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "environment": "default"
                            }
                        }
                    }
                },
                {
                    "name": "打分策略",
                    "label": "打分策略(塔8限定)",
                    "description": "基于塔8环境的选择策略，更着重于种类数与数量的均衡发展，所以可能会比通用策略使用更多刷新次数，但在设置正确的时候综合表现比通用策略更好<br>需要将预设作业设置为主控角色8种、支援角色7种潜能，建议预设潜能最低设置2级，刷新上限调到4或5，且尽量保持全程运行不中断",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "environment": "tower_8"
                            }
                        }
                    },
                    "option": [
                        "新版爬塔_潜能抓取刷新阈值系数",
                        "新版爬塔_开始任务前清空内存"
                    ]
                }
            ]
        },
        "新版爬塔_潜能抓取刷新阈值系数": {
            "type": "input",
            "label": "刷新阈值系数设置",
            "inputs": [
                {
                    "name": "刷新阈值系数",
                    "description": "该系数越高，潜能挑选会越严格，导致刷新的可能性越高<br>默认值为0.8",
                    "pipeline_type": "string",
                    "default": "0.8",
                    "verify": "^(0|[1-9])(\\.\\d{1,2})?$",
                    "pattern_msg": "请输入刷新阈值系数"
                },
                {
                    "name": "刷新阈值衰减系数",
                    "description": "该系数可以防止过度刷新，如设置为0.01，每刷新一次，刷新阈值会衰减1%<br>默认值为0.05<br>",
                    "pipeline_type": "string",
                    "default": "0.05",
                    "verify": "^(0(\\.\\d{1,2})?|1(\\.0{1,2})?)$",
                    "pattern_msg": "请输入刷新阈值衰减系数"
                }
            ],
            "pipeline_override": {
                "星塔_节点_选择潜能_agent": {
                    "attach": {
                        "threshold_coef_str": "{刷新阈值系数}",
                        "threshold_decay_str": "{刷新阈值衰减系数}"
                    }
                }
            }
        },
        "新版爬塔_开始任务前清空内存": {
            "type": "switch",
            "label": "开始任务前清空内存",
            "description": "使用塔8策略及json作业时，星塔助手会记录潜能数据以进行策略判断，如果中途结束任务，在关闭星塔助手前潜能数据会一直残留在内存中<br>所以如果需要中断任务后从头开始爬塔，需要开启该选项以清空潜能数据",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "星塔_入口_agent": {
                            "attach": {
                                "reset_state": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "星塔_入口_agent": {
                            "attach": {
                                "reset_state": false
                            }
                        }
                    }
                }
            ]
        },
        "新版爬塔_潜能最大刷新次数": {
            "type": "input",
            "inputs": [
                {
                    "name": "潜能最大刷新次数",
                    "description": "该选项优先级大于其他选项，潜能选择时，刷新次数永远不会超过该值",
                    "pipeline_type": "int",
                    "default": "5",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入潜能最大刷新次数"
                }
            ],
            "pipeline_override": {
                "星塔_节点_选择潜能_agent": {
                    "attach": {
                        "max_refresh_count": "{潜能最大刷新次数}"
                    }
                }
            }
        },
        "新版爬塔_事件选项策略文件": {
            "type": "select",
            "label": "事件选项策略文件",
            "description": "爬塔事件的对话选项策略通过json文件配置，存放在程序的/agent/agent_config/目录下",
            "default_case": "默认",
            "cases": [
                {
                    "name": "默认"
                },
                {
                    "name": "自定义文件",
                    "option": [
                        "新版爬塔_事件选项策略文件_自定义"
                    ]
                }
            ]
        },
        "新版爬塔_事件选项策略文件_自定义": {
            "type": "input",
            "inputs": [
                {
                    "name": "选项策略文件名",
                    "pipeline_type": "string",
                    "default": "ascension_event_custom.json",
                    "description": "如要使用自定义策略，请一定要新建新的json文件，不要使用默认策略的文件名，否则升级时会导致策略文件被覆盖！"
                }
            ],
            "pipeline_override": {
                "星塔_入口_agent": {
                    "attach": {
                        "event_rules": "{选项策略文件名}"
                    }
                }
            }
        },
        "预设作业_手动输入作业名": {
            "type": "input",
            "inputs": [
                {
                    "name": "预设作业_作业文件名",
                    "label": "作业文件名",
                    "pipeline_type": "string",
                    "description": "作业需以json格式保存在程序的/agent/presets/目录下，填写文件名时可以不添加.json后缀"
                }
            ],
            "pipeline_override": {
                "星塔_入口_agent": {
                    "attach": {
                        "preset_name": "{预设作业_作业文件名}"
                    }
                }
            }
        }
    }
}
