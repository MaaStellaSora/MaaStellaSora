{
    "interface_version": 2,
    "languages": {
        "zh_cn": "i18n/zh_cn.json",
        "zh_hant": "i18n/zh_cn.json",
        "en_us": "i18n/zh_cn.json",
        "ja_jp": "i18n/zh_cn.json",
        "ko_kr": "i18n/ko_kr.json"
    },
    "name": "MaaStellaSora",
    "label": "MaaStellaSora",
    "description": "$interface.description",
    "contact": "$interface.contact",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaStellaSora",
    "github": "https://github.com/MaaStellaSora/MaaStellaSora",
    "version": "0.9.5",
    "custom_title": "MaaStellaSora",
    "mirrorchyan_rid": "SSAH",
    "mirrorchyan_multiplatform": true,
    "agent": {
        "child_exec": "python",
        "child_args": [
            "-u",
            "./../agent/main.py"
        ],
        "timeout": -1
    },
    "controller": [
        {
            "name": "桌面端",
            "label": "$interface.controller.桌面端.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "xtlr|星塔旅人|ステラソラ|StellaSora",
                "screencap": "FramePool",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true,
            "attach_resource_path": [
                "resource/windows"
            ]
        },
        {
            "name": "安卓端",
            "label": "$interface.controller.安卓端.label",
            "type": "Adb"
        },
        {
            "name": "PlayCover",
            "label": "PlayCover",
            "type": "PlayCover"
        },
        {
            "name": "桌面端（前台）",
            "label": "$interface.controller.桌面端（前台）.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "xtlr|星塔旅人|ステラソラ|StellaSora",
                "screencap": "FramePool",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "Seize"
            },
            "permission_required": true,
            "attach_resource_path": [
                "resource/windows"
            ],
            "description": "$interface.controller.桌面端（前台）.description"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "$interface.resource.官服.label",
            "path": [
                "resource/base"
            ]
        },
        {
            "name": "台服",
            "label": "$interface.resource.台服.label",
            "path": [
                "resource/base",
                "resource/tw"
            ]
        },
        {
            "name": "国际服",
            "label": "$interface.resource.国际服.label",
            "path": [
                "resource/base",
                "resource/en"
            ]
        },
        {
            "name": "日服",
            "label": "$interface.resource.日服.label",
            "path": [
                "resource/base",
                "resource/jp"
            ]
        }
    ],
    "import": [
        "interface/tasks/common.json",
        "interface/tasks/login.json",
        "interface/tasks/shop.json",
        "interface/tasks/tyrants_tower.json",
        "interface/tasks/talk.json",
        "interface/tasks/invite.json",
        "interface/tasks/invite_select_cn.json",
        "interface/tasks/activity.json",
        "interface/tasks/activity_challenge.json",
        "interface/tasks/fight.json",
        "interface/tasks/quest.json",
        "interface/tasks/friend.json",
        "interface/tasks/task.json",
        "interface/tasks/mail.json",
        "interface/tasks/grant.json",
        "interface/tasks/operation.json",
        "interface/tasks/proving_grounds.json",
        "interface/tasks/climb_tower.json",
        "interface/tasks/climb_tower_shop.json",
        "interface/tasks/climb_tower_shop_enhance.json",
        "interface/tasks/climb_tower_target.json",
		"interface/tasks/cataclysm_survivor.json"
    ]
}
