                "邀约_5号": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{5号}"
                            ]
                        }
                    },
                    "focus": {
                        "Node.Recognition.Succeeded": "尝试邀约_{5号}"
                    }
                }
            }
        },
        "邀约旅人_1号_送礼": {
            "type": "select",
            "label": "1号送礼类型",
            "description": "如选择所有，只要有礼物就送。如选择最爱，则只送黄色笑脸。",
            "default_case": "所有",
            "cases": [
                {
                    "name": "所有",
                    "pipeline_override": {
                        "邀约_1号": {
                            "attach": {
                                "gift": "all"
                            }
                        }
                    }
                },
                {
                    "name": "最爱",
                    "pipeline_override": {
