{
    "采购_入口": {
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "采购_判断是否在主页",
            "[JumpBack]通用_返回主页"
        ]
    },
    "采购_判断是否在主页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "menu.png"
                ],
                "roi": [
                    1180,
                    0,
                    100,
                    80
                ]
            }
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]采购_前往采购",
            "[JumpBack]采购_前往商城",
            "采购_任务完成"
        ]
    },
    "采购_前往采购": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "procurement.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "采购_领取每日赠礼"
        ],
        "focus": {
            "Node.Action.Starting": "正在前往采购"
        }
    },
    "采购_前往商城": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "shop/shop.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "采购_领取每日赠礼"
        ],
        "focus": {
            "Node.Action.Starting": "正在前往商城"
        }
    },
    "采购_领取每日赠礼": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "shop/daily_gift_1.png",
                    "shop/daily_gift_2.png",
                    "shop/daily_gift_1_obtained.png",
                    "shop/daily_gift_2_obtained.png"
                ]
            }
        },
        "pre_delay": 1000, // 简单应对商城界面拉取礼包信息时无法点击每日赠礼的问题
        "action": {
            "type": "Click"
        },
        "next": [
            "通用_返回主页"
        ],
        "focus": {
            "Node.Action.Starting": "正在领取每日赠礼"
        }
    },
    "采购_任务完成": {
        "action": {
            "type": "DoNothing"
        }
    }
}
