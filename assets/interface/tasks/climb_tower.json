{
    "task": [
        {
            "name": "新版爬塔",
            "entry": "星塔_入口_agent",
            "description": "新版爬塔目前仍在测试，如有问题请通过issue等渠道反馈\n\n自动爬塔仅为完成日常周常使用，如要刷取冲榜纪录请自行手动刷取",
            "option": [
                "新版爬塔_开始位置",
                "新版爬塔_爬塔次数",
                "新版爬塔_属性塔",
                "新版爬塔_潜能选择模式",
                "新版爬塔_潜能最大刷新次数",
                "新版爬塔_商店_购买音符时机",
                "新版爬塔_商店_自动购买协奏音符",
                "新版爬塔_商店_音符策略",
                "新版爬塔_商店_中途商店刷新最小金额",
                "新版爬塔_商店_潜能特饮折扣",
                "新版爬塔_商店_5个音符折扣",
                "新版爬塔_商店_15个音符折扣",
                "新版爬塔_选项策略文件",
                "新版爬塔_爬塔目标",
                "新版爬塔_商店_最大强化金额",
                "新版爬塔_商店_初始强化金额"
            ]
        }
    ],
    "option": {
        "新版爬塔_开始位置": {
            "type": "select",
            "label": "开始位置",
            "description": "设置在哪个界面开始任务",
            "default_case": "主页",
            "cases": [
                {
                    "name": "开始位置_主页",
                    "label": "主页",
                    "description": "从主页开始，不需要调整编队时选择"
                },
                {
                    "name": "开始位置_进入星塔后",
                    "label": "进入星塔后",
                    "description": "进入星塔后开始，需要调整编队时或爬塔中断时选择",
                    "pipeline_override": {
                        "星塔_跳过进入星塔流程_agent": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "新版爬塔_爬塔次数": {
            "type": "input",
            "inputs": [
                {
                    "name": "爬塔次数",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入爬塔次数"
                }
            ],
            "pipeline_override": {
                "星塔_循环用节点_agent": {
                    "attach": {
                        "loop_count": "{爬塔次数}"
                    }
                }
            }
        },
        "新版爬塔_属性塔": {
            "type": "select",
            "label": "属性塔",
            "default_case": "属性_光土",
            "cases": [
                {
                    "name": "属性_光土",
                    "label": "光土",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_光土__387_137_124_45__337_87_224_145.png"
                                    ]
                                }
                            },
                            "attach": {
                                "active_melodies": ["melody_of_lux", "melody_of_terra"]
                            }
                        }
                    }
                },
                {
                    "name": "属性_水风",
                    "label": "水风",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_水风__384_271_129_39__334_221_229_139.png"
                                    ]
                                }
                            },
                            "attach": {
                                "active_melodies": ["melody_of_aqua", "melody_of_ventus"]
                            }
                        }
                    }
                },
                {
                    "name": "属性_火暗",
                    "label": "火暗",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_火暗__381_404_129_39__331_354_229_139.png"
                                    ]
                                }
                            },
                            "attach": {
                                "active_melodies": ["melody_of_ignis", "melody_of_umbra"]
                            }
                        }
                    }
                }
            ]
        },
        "新版爬塔_潜能选择模式": {
            "type": "select",
            "label": "潜能选择模式",
            "default_case": "内置选择策略",
            "cases": [
                {
                    "name": "内置选择策略",
                    "description": "会识别潜能等级、推荐等级等数据，使用内置的选择策略选择潜能",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "handler": "preset"
                            }
                        }
                    },
                    "option": [
                        "新版爬塔_塔环境"
                    ]
                },
                {
                    "name": "直接选择推荐潜能(备用)",
                    "description": "直接选择第一位的推荐潜能，如无推荐潜能将会尝试使用刷新（刷新次数会根据配置调整）。在选择策略模块失效但又不在意爬塔质量时可以使用",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "handler": "default"
                            }
                        }
                    }
                },
                {
                    "name": "自定义json优先级(停止更新)",
                    "description": "半周年后，由于游戏更新预设作业功能，自定义json优先级模块已停止更新<br>如果想要使用，请不要在预设的json保存自己的内容，版本更新时你的内容将会被覆盖！",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "handler": "json"
                            }
                        }
                    },
                    "option": [
                        "预设作业_手动输入作业名",
                        "新版爬塔_开始任务前清空内存"
                    ]
                }
            ]
        },
        "新版爬塔_塔环境": {
            "type": "select",
            "label": "塔环境",
            "default_case": "塔8环境",
            "cases": [
                {
                    "name": "通用环境",
                    "label": "通用",
                    "description": "通用环境策略，优先选择升级跨度大的，或者高等级的推荐潜能。如无推荐潜能将会刷新",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "environment": "default"
                            }
                        }
                    }
                },
                {
                    "name": "塔8环境",
                    "label": "塔8",
                    "description": "基于塔8环境的选择策略，建议将预设作业设置为主控角色8种、支援角色7种潜能，且尽量保持全程运行不中断",
                    "pipeline_override": {
                        "星塔_节点_选择潜能_agent": {
                            "attach": {
                                "environment": "tower_8"
                            }
                        }
                    },
                    "option": [
                        "新版爬塔_潜能抓取刷新阈值系数",
                        "新版爬塔_开始任务前清空内存"
                    ]
                }
            ]
        },
        "新版爬塔_潜能抓取刷新阈值系数": {
            "type": "input",
            "label": "刷新阈值系数设置",
            "inputs": [
                {
                    "name": "刷新阈值系数",
                    "description": "该系数越高，潜能挑选会越严格，导致刷新的可能性越高<br>默认值为0.8",
                    "pipeline_type": "string",
                    "default": "0.8",
                    "verify": "^(0|[1-9])(\\.\\d{1,2})?$",
                    "pattern_msg": "请输入刷新阈值系数"
                },
                {
                    "name": "刷新阈值衰减系数",
                    "description": "该系数可以防止过度刷新，如设置为0.01，每刷新一次，刷新阈值会衰减1%<br>默认值为0.05<br>",
                    "pipeline_type": "string",
                    "default": "0.05",
                    "verify": "^(0(\\.\\d{1,2})?|1(\\.0{1,2})?)$",
                    "pattern_msg": "请输入刷新阈值衰减系数"
                }
            ],
            "pipeline_override": {
                "星塔_节点_选择潜能_agent": {
                    "attach": {
                        "threshold_coef_str": "{刷新阈值系数}",
                        "threshold_decay_str": "{刷新阈值衰减系数}"
                    }
                }
            }
        },
        "新版爬塔_开始任务前清空内存": {
            "type": "switch",
            "label": "开始任务前清空内存",
            "description": "使用塔8策略及json作业时，星塔助手会记录潜能数据以进行策略判断，如果中途结束任务，在关闭星塔助手前潜能数据会一直残留在内存中<br>所以如果需要中断任务后从头开始爬塔，需要开启该选项以清空潜能数据",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "星塔_入口_agent": {
                            "attach": {
                                "reset_state": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "星塔_入口_agent": {
                            "attach": {
                                "reset_state": false
                            }
                        }
                    }
                }
            ]
        },
        "新版爬塔_潜能最大刷新次数": {
            "type": "input",
            "inputs": [
                {
                    "name": "潜能最大刷新次数",
                    "description": "该选项优先级大于其他选项，潜能选择时，刷新次数永远不会超过该值",
                    "pipeline_type": "int",
                    "default": "5",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入潜能最大刷新次数"
                }
            ],
            "pipeline_override": {
                "星塔_节点_选择潜能_agent": {
                    "attach": {
                        "max_refresh_count": "{潜能最大刷新次数}"
                    }
                }
            }
        },
        "新版爬塔_爬塔目标": {
            "type": "input",
            "label": "爬塔目标",
            "description": "在爬塔次数内达到以下目标时，仍然会停止爬塔。0为不生效。",
            "inputs": [
                {
                    "name": "潜能数目标",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入潜能数目标(≥0)"
                },
                {
                    "name": "记录等级目标",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入记录等级目标(≥0)"
                }
            ],
            "pipeline_override": {
                "星塔_循环用节点_agent": {
                    "attach": {
                        "min_potential_count": "{潜能数目标}",
                        "min_record_level": "{记录等级目标}"
                    }
                }
            }
        },
        "新版爬塔_商店_购买音符时机": {
            "type": "select",
            "label": "购买音符时机",
            "description": "选择在哪里购买音符<br>当前只支持选择是否只在最终商店购买",
            "default_case": "不限",
            "cases": [
                {
                    "name": "不限",
                    "pipeline_override": {
                        "星塔_节点_商店_购物_agent": {
                            "attach": {
                                "buy_melody_at_final_only": false
                            }
                        }
                    }
                },
                {
                    "name": "只在最终商店购买",
                    "pipeline_override": {
                        "星塔_节点_商店_购物_agent": {
                            "attach": {
                                "buy_melody_at_final_only": true
                            }
                        }
                    }
                }
            ]
        },
        "新版爬塔_商店_自动购买协奏音符": {
            "type": "select",
            "label": "自动购买协奏音符",
