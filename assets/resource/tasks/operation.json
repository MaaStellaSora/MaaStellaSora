{
    "task": [
        {
            "name": "猎影合围",
            "entry": "猎影合围_入口",
            "description": "1. 会按照协助讨伐->追踪目标的顺序消耗资源，直到到达保留数量\n2. 追踪目标时不会使用围猎许可证，如果选择等待到讨伐完成但没有人协助围猎，会一直等待直到目标逃跑\n3. 战斗时，如无选择纪录会默认选择第一个纪录\n4. 战斗使用自动战斗，请确保拥有足够的实力。如果结果不足1星，任务将会陷入无限循环",
            "option": [
                "猎影合围_开启协助讨伐",
                "猎影合围_开启追踪目标"
            ]
        }
    ],
    "option": {
        "猎影合围_开启协助讨伐": {
            "type": "switch",
            "label": "协助讨伐",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "猎影合围_协助讨伐": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "猎影合围_协助讨伐_保留数量"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "猎影合围_协助讨伐": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "猎影合围_协助讨伐_保留数量": {
            "type": "input",
            "inputs": [
                {
                    "name": "猎影合围_协助讨伐_保留围猎许可证数量",
                    "label": "保留围猎许可证数量",
                    "verify": "\\d+",
                    "default": "0",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "猎影合围_识别资源数量": {
                    "attach": {
                        "hunt_license_keep_count": "{猎影合围_协助讨伐_保留围猎许可证数量}"
                    }
                }
            }
        },
        "猎影合围_开启追踪目标": {
            "type": "switch",
            "label": "追踪目标",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "猎影合围_追踪目标": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "猎影合围_追踪目标_保留数量",
                        "猎影合围_追踪目标_是否等待讨伐完成"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "猎影合围_追踪目标": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "猎影合围_追踪目标_保留数量": {
            "type": "input",
            "inputs": [
                {
                    "name": "猎影合围_追踪目标_保留追踪委托书数量",
                    "label": "保留追踪委托书数量",
                    "verify": "\\d+",
                    "default": "0",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "猎影合围_识别资源数量": {
                    "attach": {
                        "tracking_permit_keep_count": "{猎影合围_追踪目标_保留追踪委托书数量}"
                    }
                }
            }
        },
        "猎影合围_追踪目标_是否等待讨伐完成": {
            "type": "switch",
            "label": "是否等待讨伐完成",
            "description": "如开启该选项，出击完成后会一直等待直到讨伐完成，任务只会在追踪委托书数量到达保留数量时结束\n\n如关闭该选项，出击完成后会直接结束追踪目标任务",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "猎影合围_追踪目标_等待讨伐完成": {
                            "enabled": true
                        },
                        "猎影合围_追踪目标_不等待讨伐完成": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "猎影合围_追踪目标_等待讨伐完成": {
                            "enabled": false
                        },
                        "猎影合围_追踪目标_不等待讨伐完成": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}
