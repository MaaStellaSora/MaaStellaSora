                    }
                },
                "邀约_2号": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{2号}"
                            ]
                        }
                    },
                    "focus": {
                        "Node.Recognition.Succeeded": "尝试邀约_{2号}"
                    }
                },
                "邀约_3号": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{3号}"
                            ]
                        }
                    },
                    "focus": {
                        "Node.Recognition.Succeeded": "尝试邀约_{3号}"
                    }
                },
                "邀约_4号": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{4号}"
                            ]
                        }
                    },
                    "focus": {
                        "Node.Recognition.Succeeded": "尝试邀约_{4号}"
                    }
