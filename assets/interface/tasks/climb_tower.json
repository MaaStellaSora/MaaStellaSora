                                "melody_15_discount_threshold": 0.8
                            }
                        }
                    }
                },
                {
                    "name": "15个音符折扣_5折",
                    "label": "5折",
                    "pipeline_override": {
                        "星塔_节点_商店_购物_agent": {
                            "attach": {
                                "melody_15_discount_threshold": 0.5
                            }
                        }
                    }
                }
            ]
        },
        "新版爬塔_商店_最大强化金额": {
            "type": "input",
            "inputs": [
                {
                    "name": "最大强化金额",
                    "default": "180",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "description": "单次强化消耗金币没超过该金额时，才会进行强化"
                }
            ],
            "pipeline_override": {
                "星塔_节点_商店_强化_agent": {
                    "attach": {
                        "max_cost": "{最大强化金额}"
                    }
                }
            }
        },
        "新版爬塔_选项策略文件": {
            "type": "select",
            "label": "选项策略文件",
            "description": "爬塔事件的对话选项策略通过json文件配置，存放在程序的/agent/agent_config/目录下",
            "default_case": "默认",
            "cases": [
                {
                    "name": "默认"
                },
                {
                    "name": "自定义文件",
                    "option": [
                        "新版爬塔_选项策略文件_自定义"
                    ]
                }
            ]
        },
        "新版爬塔_选项策略文件_自定义": {
            "type": "input",
            "inputs": [
                {
                    "name": "选项策略文件名",
                    "pipeline_type": "string",
                    "default": "ascension_event_custom.json",
                    "description": "如要使用自定义策略，请一定要新建新的json文件，不要使用默认策略的文件名，否则升级时会导致策略文件被覆盖！"
                }
            ],
            "pipeline_override": {
                "星塔_入口_agent": {
                    "attach": {
                        "event_rules": "{选项策略文件名}"
                    }
                }
            }
        },
        "新版爬塔_商店_初始强化金额": {
            "type": "input",
            "inputs": [
                {
                    "name": "初始强化金额",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "description": "初始强化消耗金币（不包含免费强化）<br>默认为60，研究点满时不需要自行调整"
                }
            ],
            "pipeline_override": {
                "星塔_节点_商店_强化_agent": {
                    "attach": {
                        "initial_cost": "{初始强化金额}"
                    }
                }
            }
        },
        "预设作业_手动输入作业名": {
            "type": "input",
            "inputs": [
                {
                    "name": "预设作业_作业文件名",
                    "label": "作业文件名",
                    "pipeline_type": "string",
                    "description": "作业需以json格式保存在程序的/agent/presets/目录下，填写文件名时可以不添加.json后缀"
                }
            ],
            "pipeline_override": {
                "星塔_入口_agent": {
                    "attach": {
                        "preset_name": "{预设作业_作业文件名}"
                    }
                }
            }
        }
    }
